	dlink,dch-m225|\
	edimax,ew-7476rpc|\
	edimax,ew-7478ac|\
	elecom,wrh-300cr|\
	hootoo,ht-tm05|\
	kimax,u25awf-h1|\
	kimax,u35wf|\
	kingston,mlw221|\
	kingston,mlwg2|\
	microduino,microwrt|\
	netgear,ex2700|\
	netgear,ex3700|\
	netgear,ex6120|\
	netgear,ex6130|\
	netgear,wn3000rp-v3|\
	netgear,wn3100rp-v2|\
	planex,cs-qr10|\
	planex,mzk-ex300np|\
	planex,mzk-ex750np|\
	ravpower,rp-wd03|\
	sercomm,na930|\
	tplink,re200-v1|\
	tplink,re210-v1|\
