	asus,rt-ac54u|\
	asus,rt-n14u|\
	bdcom,wap2100-sk|\
	dlink,dir-806a-b1|\
	domywifi,dm202|\
	domywifi,dm203|\
	domywifi,dw22d|\
	edimax,ew-7478apc|\
	glinet,gl-mt300a|\
	glinet,gl-mt300n|\
	glinet,gl-mt750|\
	hiwifi,hc5661|\
	snr,cpe-w4n-mt|\
	wrtnode,wrtnode|\
	zbtlink,zbt-wa05|\
