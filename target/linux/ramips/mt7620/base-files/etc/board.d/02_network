	ohyeah,oy-0001|\
	phicomm,psg1208|\
	planex,db-wrt01|\
	planex,mzk-750dhp|\
	ralink,mt7620a-evb|\
	ralink,mt7620a-mt7610e-evb|\
	ralink,mt7620a-v22sg-evb|\
	sanlinking,d240|\
	zbtlink,zbt-ape522ii|\
	zbtlink,zbt-we826-16m|\
	zbtlink,zbt-we826-32m|\
	zbtlink,zbt-we826-e|\
	zbtlink,zbt-wr8305rt|\
